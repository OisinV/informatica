from turtle import *
bgcolor('deepskyblue')
penup()
speed(0)

stapels = [2, 3, 1, 0, 1, 4, 5, 2]
mt, h = 0, 0

x = -100
for munten in stapels:
    for i in range(munten):
        goto(x, i * 20)
        dot(18, 'darkgoldenrod')
        dot(12, 'gold')
    x = x + 30
    if munten <= h:
        h = munten
    print(munten)
    if i == 0:
        mt += 1

teleport(-110, 170)
write('MUNTEN ' + str(sum(stapels)), font=('Courier', 10, 'bold'))
teleport(-110, 145)
write('LEEG ' + str(mt), font=('Courier', 10, 'bold'))
teleport(-110, 120)
write('HOOGSTE ' + str(h), font=('Courier', 10, 'bold'))
